{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run check)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npx expo export:*)",
      "Bash(npm run web:*)",
      "Bash(npx expo start:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "mcp__playwright",
      "mcp__context7"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-xlsx.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh"
          }
        ]
      }
    ]
  }
}
